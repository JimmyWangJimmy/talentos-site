---
import { dict, url, asset } from '../i18n.js';
import theme from '../content/theme.json';
const { lang = 'zh', page = 'home', title, description } = Astro.props;
const t = dict[lang];
const other = lang === 'zh' ? 'en' : 'zh';
const keys = ['services', 'research', 'about', 'contact'];
const desc = description || t.home.description;
const canonical = new URL(url(lang, page), Astro.site).href;
---
<!doctype html>
<html lang={t.lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="zh-CN" href={new URL(url('zh', page), Astro.site).href} />
<link rel="alternate" hreflang="en" href={new URL(url('en', page), Astro.site).href} />
<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
<meta name="theme-color" content={theme.bg} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<style define:vars={theme} is:global>
:root{
  --max:1120px;
  --section-y:96px;
  --radius-sm:8px;
  --radius-md:12px;
  --hero-y-top:128px;
  --hero-y-bottom:112px;
  /* kebab aliases (define:vars emits camelCase for multi-word keys) */
  --surface-alt:var(--surfaceAlt);
  --muted-soft:var(--mutedSoft);
  --on-dark:var(--onDark);
  --on-dark-muted:var(--onDarkMuted);
  --accent-hover:var(--accentHover);
  --ink-hover:var(--inkHover);
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  font-family:-apple-system,"PingFang SC","Noto Sans SC","Microsoft YaHei",system-ui,sans-serif;
  background:var(--bg);color:var(--ink);
  line-height:1.6;font-size:17px;letter-spacing:0;
}
a{color:inherit}
a:focus-visible,button:focus-visible{
  outline:2px solid var(--ink);outline-offset:2px;
}
.wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
@media (min-width:960px){.wrap{padding:0 32px}}
header{border-bottom:1px solid var(--line)}
.bar{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  min-height:56px;flex-wrap:wrap;padding-top:0;padding-bottom:0;
}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:19px;text-decoration:none;letter-spacing:-.01em}
nav ul{display:flex;gap:22px;list-style:none;flex-wrap:wrap;align-items:center}
nav a{text-decoration:none;font-size:14px;font-weight:400;color:var(--muted);padding:8px 0;display:inline-block}
nav a:hover,nav a[aria-current]{color:var(--ink)}
.pill{
  background:var(--ink)!important;color:var(--on-dark)!important;
  border:none;border-radius:var(--radius-sm);
  padding:8px 14px;font-size:14px;font-weight:500;
}
.pill:hover{background:var(--ink-hover)!important}
.lang{
  border:1px solid var(--line);border-radius:var(--radius-sm);
  padding:6px 10px;font-size:14px;color:var(--muted);
}
.lang:hover{color:var(--ink)}
main{min-height:60vh}
.hero{padding:var(--hero-y-top) 0 var(--hero-y-bottom)}
.eyebrow{color:var(--muted);font-weight:600;font-size:14px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:20px}
h1{
  font-size:clamp(40px,7vw,68px);line-height:1.08;letter-spacing:-.03em;
  font-weight:700;max-width:14em;
}
.sub{font-size:clamp(18px,2vw,21px);color:var(--muted);max-width:36em;margin-top:28px;line-height:1.5;font-weight:400}
.btns{display:flex;gap:14px;margin-top:40px;flex-wrap:wrap}
.btn{
  display:inline-block;padding:10px 18px;border-radius:var(--radius-sm);
  text-decoration:none;font-weight:500;font-size:15px;
  border:1px solid var(--ink);line-height:1.25;
}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--ink)}
.btn.primary:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
.btn.secondary{background:transparent;color:var(--ink);border:1px solid var(--ink)}
.btn.secondary:hover{background:var(--ink);color:var(--on-dark)}
.btn.ghost{background:transparent;color:var(--muted);border:1px solid transparent}
.btn.ghost:hover{color:var(--ink);border-color:var(--line)}
section.block{padding:var(--section-y) 0;border-top:none}
.block-alt{background:var(--surface-alt)}
h2{font-size:clamp(28px,3.5vw,40px);letter-spacing:-.02em;line-height:1.15;font-weight:600;margin-bottom:28px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:40px}
.grid h3{font-size:20px;font-weight:600;line-height:1.25;margin-bottom:10px}
.grid p,.item p{color:var(--muted)}
.price{margin-top:14px;font-weight:600;padding-left:12px;border-left:3px solid var(--accent)}
.item{padding:28px 0;border-bottom:1px solid var(--line)}
.date{font-size:13px;color:var(--muted-soft)}
.mail{font-size:clamp(24px,4vw,44px);font-weight:700;text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:8px;word-break:break-all}
.prose p,.prose li{color:var(--muted);max-width:42em}
.prose p+p,.prose p+ul,.prose ul+p,.prose ol+p{margin-top:14px}
.prose ul,.prose ol{padding-left:1.2em}
.prose li{margin:10px 0}
.prose strong{color:var(--ink)}
.prose a{
  color:var(--ink);text-decoration:underline;
  text-decoration-color:var(--line);text-underline-offset:4px;word-break:break-word;
}
.prose a:hover{text-decoration-color:var(--accent)}
.hero .prose a{
  display:inline-block;margin-top:32px;padding:10px 18px;
  border-radius:var(--radius-sm);background:var(--accent);border:1px solid var(--accent);
  color:var(--ink);text-decoration:none;font-weight:500;font-size:15px;line-height:1.25;
}
.hero .prose a:hover{background:var(--accent-hover);border-color:var(--accent-hover);text-decoration:none}
.slim{
  background:var(--ink);color:var(--on-dark-muted);
  border-top:none;padding:40px 0;font-size:16px;
}
.slim a{
  color:var(--on-dark);text-decoration:underline;text-decoration-color:var(--accent);
}
.slim a:hover{color:#fff}
section.block h2{margin-bottom:28px}
footer{
  background:var(--ink);color:var(--on-dark-muted);
  border-top:none;padding:56px 0 48px;font-size:14px;
}
footer a{color:var(--on-dark-muted);text-decoration:none}
footer a:hover{color:var(--on-dark)}
</style>
</head>
<body>
<header><div class="wrap bar">
<a class="logo" href={url(lang,'home')} aria-label={t.brand}><img src={asset('talentos-wordmark-light.svg')} width="139" height="32" alt={t.brand} /></a>
<nav aria-label="Main"><ul>
{keys.map(k => <li><a href={url(lang,k)} aria-current={k===page ? 'page' : undefined}>{t.nav[k]}</a></li>)}
<li><a class="pill" href={`${url(lang,'contact')}#checkup`}>{t.nav.checkup}</a></li>
<li><a class="lang" href={url(other,page)} hreflang={other==='zh'?'zh-CN':'en'} lang={other==='zh'?'zh-CN':'en'}>{t.nav.switch}</a></li>
</ul></nav>
</div></header>
<main><slot /></main>
<footer><div class="wrap"><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a> · <a href="https://x.com/KingOfRW" rel="noopener">X @KingOfRW</a> · <a href="https://github.com/JimmyWangJimmy/ai-agent-skills" rel="noopener">GitHub</a> · {t.footer}</div></footer>
</body>
</html>
