---
import { callbackEndpoint } from '../config/callback.js';
const { lang = 'zh' } = Astro.props;
const api = callbackEndpoint();
const zh = lang === 'zh';
const copy = zh
  ? {
      title: '留下电话，AI 助手回拨',
      promise: '留下手机号，我们的 AI 助手会用境外号码回拨给你。请放心接听。',
      hours: '工作日 10:00–18:00（上海时间）提交后尽快回拨；其余时间进入队列，于下一工作时段拨出。',
      phoneLabel: '手机号',
      phonePh: '13800000000',
      nameLabel: '称呼（可选）',
      namePh: '怎么称呼您',
      needLabel: '想了解什么（可选）',
      needPh: '例如：Agent 自动化体检、语音产品',
      consent:
        '我同意 TalentOS 使用我提供的手机号，由 AI 语音助手从境外号码回拨；通话开头会提示正在与 AI 通话，可能录音，仅用于本次沟通与服务改进。',
      submit: '请回拨给我',
      alt: '改用邮件预约体检',
      success: '已收到。若在回拨时段内，请留意来自境外号码的来电；未接通我们最多再试一次。',
      errPhone: '请填写有效的 11 位大陆手机号',
      errConsent: '请先勾选同意 AI 回拨',
      errNetwork: '提交失败，请稍后重试或发邮件至 james@agentbay.asia',
    }
  : {
      title: 'Leave your number—AI will call back',
      promise: 'Leave your number—our AI assistant will call back from an overseas line. Please pick up.',
      hours: 'Weekdays 10:00–18:00 (Shanghai). Outside that window, your request joins a queue for the next business window.',
      phoneLabel: 'Mobile number',
      phonePh: '13800000000',
      nameLabel: 'Name (optional)',
      namePh: 'How should we address you',
      needLabel: 'What you need (optional)',
      needPh: 'e.g. Agent check-up, voice product',
      consent:
        'I agree TalentOS may use my number for an AI voice callback from an overseas line. The call opens with an AI disclosure and may be recorded for this conversation and service improvement.',
      submit: 'Call me back',
      alt: 'Book check-up by email instead',
      success: 'Got it. During callback hours, watch for an overseas caller ID. If you miss it, we may try once more.',
      errPhone: 'Enter a valid 11-digit Mainland mobile number',
      errConsent: 'Please agree to the AI callback first',
      errNetwork: 'Submit failed. Try again later or email james@agentbay.asia',
    };
const checkupHref = zh
  ? 'mailto:james@agentbay.asia?subject=%E9%A2%84%E7%BA%A6%E5%85%8D%E8%B4%B9%2030%20%E5%88%86%E9%92%9F%20Agent%20%E8%87%AA%E5%8A%A8%E5%8C%96%E4%BD%93%E6%A3%80%20%2F%20Book%20a%20free%2030-min%20Agent%20automation%20check-up'
  : 'mailto:james@agentbay.asia?subject=Book%20a%20free%2030-min%20Agent%20automation%20check-up';
---
<section class="block block-alt" id="callback">
  <div class="wrap">
    <h2>{copy.title}</h2>
    <p class="form-lead">{copy.promise}</p>
    <p class="form-hint">{copy.hours}</p>

    <form class="form-callback" id="callback-form" novalidate data-api={api} data-lang={lang}>
      <div class="form-field">
        <label for="cb-phone">{copy.phoneLabel}</label>
        <div class="form-phone-row">
          <span class="form-prefix" aria-hidden="true">+86</span>
          <input
            class="form-input"
            type="tel"
            id="cb-phone"
            name="phone"
            inputmode="numeric"
            autocomplete="tel-national"
            maxlength="11"
            placeholder={copy.phonePh}
            required
            aria-describedby="cb-phone-err"
          />
        </div>
        <p class="form-error" id="cb-phone-err" hidden></p>
      </div>

      <div class="form-field">
        <label for="cb-name">{copy.nameLabel}</label>
        <input class="form-input" type="text" id="cb-name" name="name" maxlength="80" placeholder={copy.namePh} autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="cb-need">{copy.needLabel}</label>
        <input class="form-input" type="text" id="cb-need" name="need" maxlength="500" placeholder={copy.needPh} />
      </div>

      <label class="form-check">
        <input type="checkbox" id="cb-consent" name="consent" required />
        <span>{copy.consent}</span>
      </label>
      <p class="form-error" id="cb-consent-err" hidden></p>

      <div class="form-actions">
        <button type="submit" class="btn primary" id="cb-submit">{copy.submit}</button>
        <a class="btn secondary" href={checkupHref}>{copy.alt}</a>
      </div>
      <p class="form-error" id="cb-form-err" hidden></p>
    </form>

    <p class="form-success" id="cb-success" hidden>{copy.success}</p>
  </div>
</section>

<style>
  .form-lead {
    color: var(--muted);
    max-width: 36em;
    margin-bottom: 8px;
  }
  .form-callback {
    max-width: 480px;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-field label {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .form-phone-row {
    display: flex;
    align-items: stretch;
    gap: 0;
  }
  .form-prefix {
    display: flex;
    align-items: center;
    padding: 0 12px;
    border: 1px solid var(--line, #E8E6DF);
    border-right: none;
    border-radius: 8px 0 0 8px;
    color: var(--muted);
    font-size: 15px;
    background: var(--bg);
  }
  .form-phone-row .form-input {
    border-radius: 0 8px 8px 0;
    flex: 1;
  }
  .form-input {
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line, #E8E6DF);
    border-radius: 8px;
    background: var(--bg, #FAF9F6);
    color: var(--ink, #141413);
    font-size: 16px;
    line-height: 1.4;
    width: 100%;
    font-family: inherit;
  }
  .form-input:focus {
    outline: 2px solid var(--accent, #D97757);
    outline-offset: 1px;
    border-color: var(--accent, #D97757);
  }
  .form-input::placeholder {
    color: var(--muted, #6B6A65);
  }
  .form-hint {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted, #6B6A65);
    max-width: 42em;
  }
  .form-check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
    line-height: 1.5;
  }
  .form-check input[type="checkbox"] {
    width: 16px;
    height: 16px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--accent, #D97757);
  }
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
    align-items: center;
  }
  .form-actions .btn {
    cursor: pointer;
    min-width: 160px;
    text-align: center;
  }
  .form-actions button.btn {
    font-family: inherit;
  }
  @media (max-width: 599px) {
    .form-actions .btn { width: 100%; }
  }
  .form-error {
    color: #B42318;
    font-size: 13px;
  }
  .form-success {
    color: var(--ink);
    font-size: 15px;
    margin-top: 16px;
    max-width: 36em;
  }
  .form-callback[hidden],
  .form-success[hidden],
  .form-error[hidden] {
    display: none !important;
  }
</style>

<script is:inline define:vars={{
  msgErrPhone: copy.errPhone,
  msgErrConsent: copy.errConsent,
  msgErrNetwork: copy.errNetwork,
  msgSuccessDefault: copy.success,
}}>
(function () {
  var form = document.getElementById('callback-form');
  if (!form) return;
  var api = form.getAttribute('data-api');
  var phoneEl = document.getElementById('cb-phone');
  var consentEl = document.getElementById('cb-consent');
  var phoneErr = document.getElementById('cb-phone-err');
  var consentErr = document.getElementById('cb-consent-err');
  var formErr = document.getElementById('cb-form-err');
  var success = document.getElementById('cb-success');
  var submitBtn = document.getElementById('cb-submit');
  var re = /^1[3-9]\d{9}$/;

  function show(el, text) {
    if (!el) return;
    el.hidden = false;
    el.textContent = text || '';
  }
  function hide(el) {
    if (!el) return;
    el.hidden = true;
    el.textContent = '';
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    hide(phoneErr);
    hide(consentErr);
    hide(formErr);
    phoneEl.removeAttribute('aria-invalid');

    var phone = (phoneEl.value || '').replace(/\D/g, '');
    if (!re.test(phone)) {
      phoneEl.setAttribute('aria-invalid', 'true');
      show(phoneErr, msgErrPhone);
      phoneEl.focus();
      return;
    }
    if (!consentEl.checked) {
      show(consentErr, msgErrConsent);
      consentEl.focus();
      return;
    }

    submitBtn.disabled = true;
    var payload = {
      phone: phone,
      consent: true,
      name: (document.getElementById('cb-name').value || '').trim(),
      need: (document.getElementById('cb-need').value || '').trim(),
      source: 'contact',
      page: location.pathname || '/contact/',
    };

    fetch(api, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (res) {
        return res.json().then(function (data) {
          return { res: res, data: data };
        });
      })
      .then(function (_ref) {
        var res = _ref.res;
        var data = _ref.data;
        if (data && data.ok) {
          form.hidden = true;
          show(success, data.message || msgSuccessDefault);
          return;
        }
        // Mock / off-cap / speko fail: still show server message
        var msg = (data && data.message) || msgErrNetwork;
        if (data && data.mock) {
          msg = data.message || msg;
        }
        if (data && data.queued) {
          form.hidden = true;
          show(success, msg);
          return;
        }
        show(formErr, msg);
        if (res.status === 429 || res.status === 503) {
          /* keep form for retry / email */
        }
      })
      .catch(function () {
        show(formErr, msgErrNetwork);
      })
      .finally(function () {
        submitBtn.disabled = false;
      });
  });
})();
</script>
