---
import Base from '../layouts/Base.astro';
import { meta } from '../copy.js';
import { CHECKUP_ENDPOINT, CHECKUP_EMAIL } from '../config/checkup.js';
const { lang = 'zh' } = Astro.props;
const m = meta(lang, 'checkup');
const T = {
  zh: {
    type: '预约类型', t1: 'AI 体检 30 分钟', t2: '免费试做 5 张主图',
    sampleHead: '免费试做 5 张电商主图',
    sampleP: '限 1 个 SKU，提供白底图即可。适合亚马逊、淘宝卖家先看效果再决定。',
    platform: '店铺平台', pAmazon: '亚马逊', pTaobao: '淘宝', pOther: '其他', pPick: '请选择',
    url: '商品链接', urlPh: 'https://www.amazon.com/dp/…',
    imgNote: '不需要在这里上传图片：提交后请把商品白底图发到 ',
    errPlat: '试做主图请选择店铺平台。',
    h1: '免费 30 分钟 AI 体检',
    sub: '一次线上沟通，帮你找出最值得先交给 AI 的那件事。不推销，聊完给你一份简短建议。',
    lookHead: '我们会看什么',
    look: [
      ['AI 提效场景', '梳理日常重复工作：资料整理、报表、客服回复、信息监控，判断哪些交给 AI 最省时间。'],
      ['电商批量出图', '商品主图、场景图、详情页素材，评估批量生成的效果、成本和交付周期。'],
      ['Agent 自动化', '把一个固定流程做成自动运行的 Agent，估算投入、风险和回报。'],
    ],
    formHead: '预约体检',
    formSub: '填写下面的信息，我们会在 1 个工作日内通过微信、电话或邮件联系你确认时间。',
    name: '姓名', company: '公司 / 店铺', contact: '微信或电话', email: '邮箱',
    problem: '想解决的问题', time: '期望时间',
    problemPh: '例如：每周要做 200 张商品主图；每天手动整理竞品信息……',
    timePh: '例如：工作日下午 / 10 月 22 日上午',
    hint: '微信/电话和邮箱至少填一项。',
    submit: '提交预约', sending: '提交中…',
    ok: '已收到预约，我们会在 1 个工作日内联系你。编号：',
    err: '提交没有成功，请稍后重试，或直接发邮件预约：',
    errFields: '请检查必填项：姓名、想解决的问题，以及微信/电话或邮箱至少一项。',
    rate: '提交太频繁了，请稍后再试，或直接发邮件：',
    mail: '用邮件预约',
    subject: '预约免费 30 分钟 AI 体检',
  },
  en: {
    type: 'Request type', t1: '30-min AI check-up', t2: 'Free trial: 5 product images',
    sampleHead: 'Free trial: 5 e-commerce main images',
    sampleP: 'One SKU, just send a white-background photo. Built for Amazon and Taobao sellers who want to see results first.',
    platform: 'Store platform', pAmazon: 'Amazon', pTaobao: 'Taobao', pOther: 'Other', pPick: 'Select',
    url: 'Product link', urlPh: 'https://www.amazon.com/dp/…',
    imgNote: 'No upload here — after submitting, email your white-background product photo to ',
    errPlat: 'Please choose your store platform for the image trial.',
    h1: 'Free 30-minute AI check-up',
    sub: 'One online call to find the single thing most worth handing to AI first. No hard sell — you get a short written recommendation afterwards.',
    lookHead: 'What we look at',
    look: [
      ['AI productivity', 'Map your repetitive work — research, reports, customer replies, monitoring — and find where AI saves the most time.'],
      ['Bulk e-commerce images', 'Product shots, lifestyle scenes and detail-page assets: quality, cost and turnaround for generating them in bulk.'],
      ['Agent automation', 'Turn one fixed workflow into an agent that runs on its own, with effort, risk and payoff estimated.'],
    ],
    formHead: 'Book your check-up',
    formSub: "Fill in the form and we'll contact you within one business day by WeChat, phone or email to confirm a time.",
    name: 'Name', company: 'Company / store', contact: 'WeChat or phone', email: 'Email',
    problem: 'What do you want to solve?', time: 'Preferred time',
    problemPh: 'e.g. We need 200 product images a week; we compile competitor news by hand every day…',
    timePh: 'e.g. Weekday afternoons (China time) / Oct 22 morning',
    hint: 'Please give at least one of WeChat/phone or email.',
    submit: 'Book now', sending: 'Sending…',
    ok: "Got it — we'll be in touch within one business day. Reference: ",
    err: "Something went wrong. Please try again later, or book by email: ",
    errFields: 'Please check the required fields: name, what you want to solve, and WeChat/phone or email.',
    rate: 'Too many submissions — please try later, or email us: ',
    mail: 'Book by email',
    subject: 'Book a free 30-min AI check-up',
  },
}[lang];
const mailBody = lang === 'zh'
  ? '姓名：\n公司/店铺：\n微信或电话：\n想解决的问题：\n期望时间：\n'
  : 'Name:\nCompany/store:\nWeChat or phone:\nWhat I want to solve:\nPreferred time:\n';
const mailto = `mailto:${CHECKUP_EMAIL}?subject=${encodeURIComponent(T.subject)}&body=${encodeURIComponent(mailBody)}`;
---
<Base lang={lang} page="checkup" title={m.title} description={m.description}>
<section class="hero"><div class="wrap">
  <h1>{T.h1}</h1>
  <p class="sub">{T.sub}</p>
  <div class="btns"><a class="btn primary" href="#book">{T.formHead} ↓</a><a class="btn secondary" href={mailto}>{T.mail}</a></div>
</div></section>
<section class="block block-alt"><div class="wrap">
  <h2>{T.lookHead}</h2>
  <div class="grid">{T.look.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}</div>
  <div class="ck-offer"><h3>{T.sampleHead}</h3><p>{T.sampleP}</p><a class="btn primary" href="#book" data-pick="sample5">{T.t2} ↓</a></div>
</div></section>
<section class="block" id="book"><div class="wrap">
  <h2>{T.formHead}</h2>
  <p class="ck-sub">{T.formSub}</p>
  <form class="ck" id="ck-form" data-endpoint={CHECKUP_ENDPOINT} data-lang={lang} novalidate>
    <fieldset class="ck-type"><legend>{T.type}</legend>
      <label><input type="radio" name="type" value="checkup30" checked /> {T.t1}</label>
      <label><input type="radio" name="type" value="sample5" /> {T.t2}</label>
    </fieldset>
    <div class="ck-row">
      <label>{T.name} *<input name="name" required maxlength="60" autocomplete="name" /></label>
      <label>{T.company}<input name="company" maxlength="120" autocomplete="organization" /></label>
    </div>
    <div class="ck-row">
      <label>{T.contact}<input name="contact" maxlength="60" autocomplete="tel" /></label>
      <label>{T.email}<input name="email" type="email" maxlength="200" autocomplete="email" /></label>
    </div>
    <p class="ck-hint">{T.hint}</p>
    <div class="ck-sample" hidden>
      <div class="ck-row">
        <label>{T.platform} *<select name="platform"><option value="">{T.pPick}</option><option value="amazon">{T.pAmazon}</option><option value="taobao">{T.pTaobao}</option><option value="other">{T.pOther}</option></select></label>
        <label>{T.url}<input name="productUrl" type="url" maxlength="500" placeholder={T.urlPh} /></label>
      </div>
      <p class="ck-hint">{T.imgNote}<a href={`mailto:${CHECKUP_EMAIL}?subject=${encodeURIComponent(T.t2)}`}>{CHECKUP_EMAIL}</a></p>
    </div>
    <label>{T.problem} <span class="ck-req">*</span><textarea name="problem" required maxlength="2000" rows="5" placeholder={T.problemPh}></textarea></label>
    <label>{T.time}<input name="preferredTime" maxlength="120" placeholder={T.timePh} /></label>
    <label class="ck-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
    <div class="btns ck-btns">
      <button type="submit" class="btn primary" data-sending={T.sending}>{T.submit}</button>
      <a class="btn ghost" href={mailto}>{T.mail} · {CHECKUP_EMAIL}</a>
    </div>
    <p class="ck-msg" role="status" aria-live="polite"
      data-ok={T.ok} data-err={T.err} data-fields={T.errFields} data-rate={T.rate} data-plat={T.errPlat} data-mailto={mailto} data-email={CHECKUP_EMAIL}></p>
  </form>
</div></section>
</Base>
<style>
.ck-sub{color:var(--muted);max-width:42em;margin-bottom:32px}
.ck{max-width:760px;display:grid;gap:18px}
.ck-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.ck label{display:grid;gap:8px;font-size:14px;font-weight:500;color:var(--ink)}
.ck input,.ck textarea,.ck select{
  font:inherit;font-size:16px;color:var(--ink);background:#fff;
  border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px 12px;width:100%;
}
.ck input:focus,.ck textarea:focus{outline:2px solid var(--ink);outline-offset:1px;border-color:var(--ink)}
.ck textarea{resize:vertical}
.ck input[type=radio]{width:auto;accent-color:var(--accent)}
.ck-type{border:none;display:flex;gap:24px;flex-wrap:wrap}
.ck-type legend{font-size:14px;font-weight:500;margin-bottom:8px}
.ck-type label{display:flex;align-items:center;gap:8px;font-size:16px}
.ck-sample{display:grid;gap:18px}.ck-sample[hidden]{display:none}
.ck-offer{margin-top:48px;padding:28px;border-left:3px solid var(--accent);background:var(--bg);border-radius:var(--radius-sm)}
.ck-offer h3{font-size:20px;margin-bottom:8px}.ck-offer p{color:var(--muted);margin-bottom:20px}
.ck-hint{font-size:13px;color:var(--muted-soft);margin-top:-8px}
.ck-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.ck-btns{margin-top:8px}
.ck button{cursor:pointer;font-family:inherit}
.ck button[disabled]{opacity:.6;cursor:wait}
.ck-msg{min-height:1.6em;font-size:15px;color:var(--ink)}
.ck-msg.err{color:#A3412A}
.ck-msg a{color:var(--ink);text-decoration-color:var(--accent);text-underline-offset:4px}
</style>
<script>
const f = document.getElementById('ck-form');
if (f) {
  const msg = f.querySelector('.ck-msg');
  const btn = f.querySelector('button[type=submit]');
  const show = (text, err, withMail) => {
    msg.className = 'ck-msg' + (err ? ' err' : '');
    msg.textContent = text;
    if (withMail) { const a = document.createElement('a'); a.href = msg.dataset.mailto; a.textContent = msg.dataset.email; msg.append(a); }
  };
  const sample = f.querySelector('.ck-sample'); const req = f.querySelector('.ck-req');
  const sync = () => { const s5 = f.type.value === 'sample5'; sample.hidden = !s5; req.hidden = s5; };
  f.querySelectorAll('input[name=type]').forEach(r => r.addEventListener('change', sync));
  document.querySelectorAll('[data-pick]').forEach(a => a.addEventListener('click', () => { f.querySelector(`input[value=${a.dataset.pick}]`).checked = true; sync(); }));
  if (location.hash === '#sample') { f.querySelector('input[value=sample5]').checked = true; }
  sync();
  f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(f).entries());
    const s5 = d.type === 'sample5';
    if (s5 && !d.platform) { show(msg.dataset.plat, true); return; }
    if (!d.name.trim() || (!s5 && !d.problem.trim()) || (!d.contact.trim() && !d.email.trim())) { show(msg.dataset.fields, true); return; }
    const label = btn.textContent; btn.disabled = true; btn.textContent = btn.dataset.sending;
    try {
      const r = await fetch(f.dataset.endpoint, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...d, lang: f.dataset.lang, page: location.pathname }),
      });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.ok) { f.reset(); sync(); show(msg.dataset.ok + (j.requestId || ''), false); }
      else if (r.status === 429) show(msg.dataset.rate, true, true);
      else if (j.error === 'invalid_fields') show(msg.dataset.fields, true);
      else show(msg.dataset.err, true, true);
    } catch { show(msg.dataset.err, true, true); }
    finally { btn.disabled = false; btn.textContent = label; }
  });
}
</script>
